<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header clickable -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header_clickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <!-- STT -->
            <TextView
                android:id="@+id/txt_stt"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Năm học -->
            <TextView
                android:id="@+id/txt_year_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2025-2026"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/txt_stt"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Học kỳ -->
            <TextView
                android:id="@+id/txt_semester_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="HK1"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="normal"
                app:layout_constraintStart_toEndOf="@+id/txt_year_item"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Tên môn học -->
            <TextView
                android:id="@+id/txt_subject_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên môn học"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/txt_semester_item"
                app:layout_constraintEnd_toStartOf="@+id/txt_avg_year"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Điểm trung bình -->
            <TextView
                android:id="@+id/txt_avg_year"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_grade_badge"
                android:gravity="center"
                android:minWidth="50dp"
                android:paddingHorizontal="8dp"
                android:text="9.3"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_expand_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Mũi tên dropdown -->
            <ImageView
                android:id="@+id/btn_expand_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#64748B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Chi tiết mở rộng -->
        <LinearLayout
            android:id="@+id/layout_subject_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Bảng điểm chi tiết -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHI TIẾT ĐIỂM THÀNH PHẦN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.08" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow
                        android:background="#3B82F6"
                        android:paddingVertical="10dp">

                        <TextView
                            style="@style/DiemTableHead"
                            android:text="Thành phần"
                            android:textColor="@android:color/white" />

                        <TextView
                            style="@style/DiemTableHead"
                            android:text="Điểm"
                            android:textColor="@android:color/white" />

                        <TextView
                            style="@style/DiemTableHead"
                            android:text="Hệ số"
                            android:textColor="@android:color/white" />
                    </TableRow>

                    <TableRow
                        android:background="#FFFFFF"
                        android:paddingVertical="10dp">

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="Điểm miệng" />

                        <TextView
                            android:id="@+id/txt_score_oral"
                            style="@style/DiemTableBody"
                            android:text="---" />

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="x1" />
                    </TableRow>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0" />

                    <TableRow
                        android:background="#FFFFFF"
                        android:paddingVertical="10dp">

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="Điểm 15 phút" />

                        <TextView
                            android:id="@+id/txt_score_15m"
                            style="@style/DiemTableBody"
                            android:text="---" />

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="x1" />
                    </TableRow>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0" />

                    <TableRow
                        android:background="#FFFFFF"
                        android:paddingVertical="10dp">

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="Điểm giữa kỳ" />

                        <TextView
                            android:id="@+id/txt_score_mid"
                            style="@style/DiemTableBody"
                            android:text="---" />

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="x2" />
                    </TableRow>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0" />

                    <TableRow
                        android:background="#F1F5F9"
                        android:paddingVertical="12dp">

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="Điểm cuối kỳ"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />

                        <TextView
                            android:id="@+id/txt_score_final"
                            style="@style/DiemTableBody"
                            android:text="---"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />

                        <TextView
                            style="@style/DiemTableBody"
                            android:text="x3"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />
                    </TableRow>
                </TableLayout>
            </androidx.cardview.widget.CardView>

            <!-- Điểm trung bình môn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/holo_blue_light"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Điểm trung bình môn:"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_score_sem_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="#1E3A8A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>