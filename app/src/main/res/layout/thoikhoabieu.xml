<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_thoikhoabieu_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true">

    <!-- Toolbar - Thêm fitsSystemWindows -->
    <include
        android:id="@+id/toolbar_header"
        layout="@layout/toolbar_header"
        android:fitsSystemWindows="true" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="false"
        android:paddingTop="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="100dp"
            android:clickable="false"
            android:focusable="false">

            <!-- Header Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:text="Lịch học "
                android:textColor="#1A2332"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Thông tin học kỳ và lớp -->
            <TextView
                android:id="@+id/tv_semester_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Học kỳ: -- | Lớp: --"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginBottom="12dp" />

            <!-- Rest of your layout remains the same -->
            <!-- Segment Control -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:clickable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:background="@drawable/segment_background"
                    android:clickable="false">

                    <TextView
                        android:id="@+id/btn_view_week"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Xem theo tuần"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/segment_selected_blue"
                        android:paddingHorizontal="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_view_full"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Xem cả kỳ"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:background="@drawable/segment_unselected_white"
                        android:paddingHorizontal="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Export Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2"
                android:clickable="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_pdf"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Xuất Excel 1"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_pdf"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_excel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Xuất Excel 2"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_excel"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:backgroundTint="#059669"
                    app:cornerRadius="10dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Info Card - Tuần hiển thị -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_current_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:clickable="false"
                        android:focusable="false">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Tuần hiển thị"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_current_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang tải..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A2332"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_pick_week"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_calendar"
                        android:background="@drawable/bg_calendar_button"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:tint="#FFFFFF" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rest of your layout continues -->
            <!-- Tiêu đề bảng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="4dp"
                android:clickable="false">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="Tiết"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Môn học - Giáo viên"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

            </LinearLayout>

            <!-- Area for subject cards -->
            <LinearLayout
                android:id="@+id/container_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:clickable="false" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginVertical="16dp"
                android:clickable="false" />

            <!-- Week Selection Title with Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:clickable="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 Chọn tuần xem"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A2332" />

                <TextView
                    android:id="@+id/txt_current_week_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Tuần hiện tại"
                    android:textSize="11sp"
                    android:textColor="#F59E0B"
                    android:visibility="gone"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <!-- Grid Weeks Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grid_weeks_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:clickable="false">

                <GridLayout
                    android:id="@+id/grid_weeks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:padding="8dp"
                    android:clickable="false" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>