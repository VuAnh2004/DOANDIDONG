<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/btn_back_home_toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&lt;"
                android:textSize="26sp"
                android:textColor="#1E3A8A"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/logotruong" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRƯỜNG THPT ANH SƠN I"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống thông minh"
                    android:textSize="11sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notifications_none_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E3A8A" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_settings_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E3A8A" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/anhuser" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="40dp">

            <!-- Result Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="32dp">

                    <RelativeLayout
                        android:layout_width="140dp"
                        android:layout_height="100dp">
                        <!-- Success Circle Icon - Updated to ic_check_v -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="40dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#10B981"
                            android:layout_centerInParent="true">
                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_v"
                                app:tint="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Confetti placeholders -->
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#F59E0B" android:layout_alignParentTop="true" android:layout_alignParentStart="true" android:layout_marginTop="10dp" android:layout_marginStart="20dp"/>
                        <View android:layout_width="5dp" android:layout_height="5dp" android:background="#EF4444" android:layout_alignParentTop="true" android:layout_alignParentEnd="true" android:layout_marginTop="20dp" android:layout_marginEnd="10dp"/>
                        <View android:layout_width="7dp" android:layout_height="7dp" android:background="#3B82F6" android:layout_alignParentBottom="true" android:layout_marginStart="30dp"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giao dịch thành công"
                        android:textColor="#10B981"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tv_recipient_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tới PHẠM THỊ ANH"
                        android:textColor="#64748B"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tv_amount_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100.000 VND"
                        android:textColor="#10B981"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="32dp" />

                    <!-- Decorative wave at the bottom -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="#E6FFFA"
                        android:alpha="0.6" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_excel"
                            app:tint="#1E3A8A" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THÔNG TIN CHI TIẾT"
                            android:textColor="#1E3A8A"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <include android:id="@+id/row_order_id" layout="@layout/item_transaction_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <include android:id="@+id/row_transaction_id" layout="@layout/item_transaction_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <include android:id="@+id/row_description" layout="@layout/item_transaction_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <include android:id="@+id/row_date" layout="@layout/item_transaction_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Blue Message -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E9F0FF"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/faceid"
                        app:tint="#2563EB" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi!"
                        android:textColor="#2563EB"
                        android:textSize="12.5sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_home"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="28dp"
                android:text="Hoàn thành"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:backgroundTint="#2563EB"
                app:icon="@drawable/ic_check_v"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download_receipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="12dp"
                android:text="Tải biên lai"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                app:strokeColor="#2563EB"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_pdf"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#2563EB" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>