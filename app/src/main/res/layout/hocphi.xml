<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FE"
    android:fitsSystemWindows="false">

    <include layout="@layout/toolbar_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Wallet Card Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_wallet_card_gradient"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/wallet_label_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số dư ví hiện tại"
                            android:textColor="#E0E7FF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/balance_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/wallet_label_container"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btn_toggle_visibility"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_soft_overlay"
                            android:src="@drawable/ic_eye"
                            app:tint="#FFFFFF"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Toggle Visibility" />

                        <TextView
                            android:id="@+id/txt_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="540.000 đ"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/img_wallet_illustration"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/imgtien"
                        android:scaleType="fitCenter"
                        android:alpha="1.0" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Deposit Card Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/vinaptien" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nạp tiền vào ví"
                            android:textColor="#1E3A8A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/input_modern_bg"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="đ"
                            android:textColor="#64748B"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />
                        <EditText
                            android:id="@+id/edt_amount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Nhập số tiền (VNĐ)"
                            android:inputType="number"
                            android:textSize="17sp"
                            android:textColor="#1E293B" />
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:columnCount="4">
                        <TextView
                            android:id="@+id/btn_100k"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_amount"
                            android:gravity="center"
                            android:text="100.000đ"
                            android:textColor="#3B82F6"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/btn_200k"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_amount"
                            android:gravity="center"
                            android:text="200.000đ"
                            android:textColor="#3B82F6"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/btn_500k"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_amount"
                            android:gravity="center"
                            android:text="500.000đ"
                            android:textColor="#3B82F6"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/btn_1m"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_amount"
                            android:gravity="center"
                            android:text="1.000.000đ"
                            android:textColor="#3B82F6"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </GridLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deposit"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="24dp"
                        android:text="NẠP TIỀN"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        app:cornerRadius="18dp"
                        app:backgroundTint="#4F46E5"
                        android:letterSpacing="0.05" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Menu Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_nav_unpaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/phananh" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danh sách khoản chưa nộp"
                            android:textColor="#111827"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem và thanh toán các khoản phí, lệ phí"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_settings_24"
                        app:tint="#94A3B8"
                        android:rotation="-90" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed List (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_nghia_vu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_nghia_vu" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>