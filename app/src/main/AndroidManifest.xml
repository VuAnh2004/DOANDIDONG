<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Quyền đọc/ghi bộ nhớ (cho lưu thẻ) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Quyền sử dụng sinh trắc học (vân tay/Face ID) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DOANQLDIEM"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".hosonguoihocActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".cauhinhActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".diemActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".vietdonActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".create_vietdonActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".muonphongActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".create_muonphongActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".phananhActivity"
            android:screenOrientation="portrait" />

        <!-- ⭐ capnhathosoActivity (Thẻ học sinh) -->
        <activity
            android:name=".capnhathosoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".thongbaoActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".thoikhoabieuActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".hocphiActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Thanh toán thành công -->
        <activity
            android:name=".thanhtoanthanhcongActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter android:label="Thanh toán thành công">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myapp" android:host="payment-success" />
            </intent-filter>
        </activity>

        <!-- ⭐ FILE PROVIDER - Để chia sẻ file ảnh thẻ học sinh ⭐ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>